[gd_resource type="Resource" script_class="CharacterCard" format=3]

[ext_resource type="Script" uid="uid://cmoe2lyoum0oe" path="res://scripts/cards/character_card.gd" id="1_card"]
[ext_resource type="Script" uid="uid://8pkq1chvkr5a" path="res://scripts/abilities/ability.gd" id="2_abil"]
[ext_resource type="Script" uid="uid://b0mosco1r307u" path="res://scripts/abilities/trigger.gd" id="3_trig"]
[ext_resource type="Script" uid="uid://b60jxsqdv6nrd" path="res://scripts/abilities/target.gd" id="4_tgt"]
[ext_resource type="Script" uid="uid://t72vfvkvypd8" path="res://scripts/abilities/effect_step.gd" id="5_eff"]

[sub_resource type="Resource" id="Resource_ab0_trig"]
script = ExtResource("3_trig")
event = "ON_PLAY"
modifier1 = "ALLY"
modifier2 = "Spell"
game_state_condition = "ally_pile_type_count:TRAP>=1"
trigger_interactors = {"PlayedCard": "type:TRAP"}

[sub_resource type="Resource" id="Resource_ab0_tgt0"]
script = ExtResource("4_tgt")
target_type = "Pile"
owner = "Ally"
targeting = "Automatic"

[sub_resource type="Resource" id="Resource_ab0_eff0"]
script = ExtResource("5_eff")
step = "Search"
parameters = {"SearchFilters": "type:TRAP", "SelectAmount": 1, "Prompt": "Válassz egy Csapdát, amit felhúzol!"}
tag = "chosen_trap"
target_ref = "targets[0]"

[sub_resource type="Resource" id="Resource_ab0_eff1"]
script = ExtResource("5_eff")
step = "MoveToZone"
target_ref = "chosen_trap.SearchResults"

[sub_resource type="Resource" id="Resource_ab0_eff2"]
script = ExtResource("5_eff")
step = "ModifyStat"
parameters = {"ModifiedStat": "COST", "SetAmount": 0, "ModifyDuration": 0}
target_ref = "chosen_trap.SearchResults"

[sub_resource type="Resource" id="Resource_ab0_eff3"]
script = ExtResource("5_eff")
step = "Search"
parameters = {"SearchFilters": "type:TRAP", "SelectAmount": -1}
tag = "remaining_traps"
target_ref = "targets[0]"

[sub_resource type="Resource" id="Resource_ab0_eff4"]
script = ExtResource("5_eff")
step = "Exile"
target_ref = "remaining_traps.SearchResults"

[sub_resource type="Resource" id="Resource_ab0"]
script = ExtResource("2_abil")
ability_name = "Káosz Csapdák"
description = "Ha két Csapdád van a rakáson, húzd fel az egyiket (költsége 0 lesz), a másik megsemmisül."
trigger = SubResource("Resource_ab0_trig")
targets = [SubResource("Resource_ab0_tgt0")]
effects = [SubResource("Resource_ab0_eff0"), SubResource("Resource_ab0_eff1"), SubResource("Resource_ab0_eff2"), SubResource("Resource_ab0_eff3"), SubResource("Resource_ab0_eff4")]

[resource]
script = ExtResource("1_card")
title = "a Káoszcsapdász"
card_id = 1012
card_name = "Fuedrax"
description = "Amikor kijátszol egy Csapda kártyát és van már másik Csapda a rakásodon, húzd fel az egyiket és a költsége 0 lesz. A másik megsemmisül."
card_class = "Vaják"
abilities = [SubResource("Resource_ab0")]
