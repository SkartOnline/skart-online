[gd_resource type="Resource" script_class="SpellCard" format=3]

[ext_resource type="Script" uid="uid://bo6m1vdd0m4vq" path="res://scripts/cards/spell_card.gd" id="1_card"]
[ext_resource type="Script" uid="uid://8pkq1chvkr5a" path="res://scripts/abilities/ability.gd" id="2_abil"]
[ext_resource type="Script" uid="uid://b0mosco1r307u" path="res://scripts/abilities/trigger.gd" id="3_trig"]
[ext_resource type="Script" uid="uid://b60jxsqdv6nrd" path="res://scripts/abilities/target.gd" id="4_tgt"]
[ext_resource type="Script" uid="uid://t72vfvkvypd8" path="res://scripts/abilities/effect_step.gd" id="5_eff"]

[sub_resource type="Resource" id="Resource_ab0_trig"]
script = ExtResource("3_trig")
event = "ON_DEATH"

[sub_resource type="Resource" id="Resource_ab0_tgt0"]
script = ExtResource("4_tgt")
target_type = "Card"
owner = "Ally"
targeting = "Self"

[sub_resource type="Resource" id="Resource_ab0_eff0"]
script = ExtResource("5_eff")
step = "ModifyCounter"
parameters = {"CounterType": "Charge", "ModifyAmount": 1, "MaxCount": 12}
target_ref = "targets[0]"

[sub_resource type="Resource" id="Resource_ab0"]
script = ExtResource("2_abil")
ability_name = "Töltés"
description = "Amikor egy egység meghal, +1 számláló (max. 12)."
trigger = SubResource("Resource_ab0_trig")
targets = [SubResource("Resource_ab0_tgt0")]
effects = [SubResource("Resource_ab0_eff0")]

[sub_resource type="Resource" id="Resource_ab1_trig"]
script = ExtResource("3_trig")
event = "ON_COUNTER_COUNT"
parameters = {"CounterType": "Charge", "CounterCount": 12}

[sub_resource type="Resource" id="Resource_ab1_tgt0"]
script = ExtResource("4_tgt")
target_type = "Unit"
owner = "Ally"
targeting = "PlayerChoice"
prompt = "Válassz egységet a Sérthetetlen pajzshoz!"

[sub_resource type="Resource" id="Resource_ab1_eff0"]
script = ExtResource("5_eff")
step = "ModifyKeyword"
parameters = {"AddedKeywords": ["Sérthetetlen"], "NewKeywordDurations": 0}
target_ref = "targets[0]"

[sub_resource type="Resource" id="Resource_ab1_eff1_sub0"]
script = ExtResource("5_eff")
step = "Exile"
target_ref = "SELF_CARD"

[sub_resource type="Resource" id="Resource_ab1_eff1"]
script = ExtResource("5_eff")
step = "Attach"
target_ref = "targets[0]"
sub_effects = [SubResource("Resource_ab1_eff1_sub0")]

[sub_resource type="Resource" id="Resource_ab1"]
script = ExtResource("2_abil")
ability_name = "Sérthetetlen Pajzs"
description = "Ha 12 számláló van rajta: csatolj egy szövetségeshez és tedd Sérthetetlenné!"
trigger = SubResource("Resource_ab1_trig")
targets = [SubResource("Resource_ab1_tgt0")]
effects = [SubResource("Resource_ab1_eff0"), SubResource("Resource_ab1_eff1")]

[sub_resource type="Resource" id="Resource_ab2_trig"]
script = ExtResource("3_trig")
event = "ON_PROTECTION_TRIGGERED"

[sub_resource type="Resource" id="Resource_ab2_tgt0"]
script = ExtResource("4_tgt")
target_type = "Card"
owner = "Ally"
targeting = "Self"

[sub_resource type="Resource" id="Resource_ab2_eff0_sub0"]
script = ExtResource("5_eff")
step = "ModifyCounter"
parameters = {"CounterType": "Charge", "ModifyAmount": -2}
target_ref = "targets[0]"

[sub_resource type="Resource" id="Resource_ab2_eff0_else0"]
script = ExtResource("5_eff")
step = "Exile"
target_ref = "targets[0]"

[sub_resource type="Resource" id="Resource_ab2_eff0"]
script = ExtResource("5_eff")
step = ""
flow = {"type": "conditional", "condition": "self_counter >= 2"}
sub_effects = [SubResource("Resource_ab2_eff0_sub0")]
else_effects = [SubResource("Resource_ab2_eff0_else0")]

[sub_resource type="Resource" id="Resource_ab2"]
script = ExtResource("2_abil")
ability_name = "Pajzs Kopás"
description = "Valahányszor a védett egységet védelem megakadályoz, -2 számláló. Ha nem tud, a Gömb megsemmisül."
trigger = SubResource("Resource_ab2_trig")
targets = [SubResource("Resource_ab2_tgt0")]
effects = [SubResource("Resource_ab2_eff0")]

[resource]
script = ExtResource("1_card")
card_type = Card.CardType.ARTIFACT
card_id = 4001
card_name = "A Gömb"
description = "Amikor egy egység meghal, tegyél rám egy számlálót (max. 12). Amikor 12 számláló van rajtam, kijelölhetsz egy szövetséges egységet. Amíg játékban vagyok, az az egység Sérthetetlen.

Valahányszor ez az egység sebződne, meghalna, megsemmisülne vagy elhagyná az arénát, távolíts el 2 számlálót rólam. Ha így nem tudsz 2 számlálót eltávolítani, semmisíts meg!"
card_class = "Mítikus"
cost = 0
abilities = [SubResource("Resource_ab0"), SubResource("Resource_ab1"), SubResource("Resource_ab2")]
