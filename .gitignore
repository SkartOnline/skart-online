# Machine-local Claude Code state: approved-permission lists with absolute
# paths from whichever machine created them. `launch.json` next to it is
# committed on purpose — it is the dev-server config and it travels fine.
.claude/settings.local.json
node_modules/
dist/

# A relay address is per-checkout. `.env.example` is the one that travels.
.env
.env.*
!.env.example
