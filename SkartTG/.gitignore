# Godot 4+ specific ignores
.godot/
/android/

# Godot web export build artifacts (generated — run Godot export to rebuild)
server/public/godot/

# Node.js
server/node_modules/
server/dist/

# Database / user data (runtime file, not committed — contains accounts & collections)
server/data/db.json

# Environment / secrets
.env
.env.*
!.env.example

# Backup files (generated by tools)
*.bak

# Log files
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
