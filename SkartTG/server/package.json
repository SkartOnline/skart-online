{
  "name": "skart-online-server",
  "version": "1.0.0",
  "description": "Backend server for Skart 2 Online card game",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "generate-cards": "cd .. && node -e \"require('./server/node_modules/ts-node').register({project:'./tools/tsconfig.json'});require('./tools/generate_cards.ts')\"",
    "validate-cards": "cd .. && node -e \"require('./server/node_modules/ts-node').register({project:'./tools/tsconfig.json'});require('./tools/validate_cards.ts')\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
