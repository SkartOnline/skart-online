[gd_resource type="Resource" script_class="SpellCard" format=3]

[ext_resource type="Script" uid="uid://bo6m1vdd0m4vq" path="res://scripts/cards/spell_card.gd" id="1_card"]
[ext_resource type="Script" uid="uid://8pkq1chvkr5a" path="res://scripts/abilities/ability.gd" id="2_abil"]
[ext_resource type="Script" uid="uid://b0mosco1r307u" path="res://scripts/abilities/trigger.gd" id="3_trig"]
[ext_resource type="Script" uid="uid://b60jxsqdv6nrd" path="res://scripts/abilities/target.gd" id="4_tgt"]
[ext_resource type="Script" uid="uid://t72vfvkvypd8" path="res://scripts/abilities/effect_step.gd" id="5_eff"]

[sub_resource type="Resource" id="Resource_ab0_trig"]
script = ExtResource("3_trig")
event = "ON_PLAY"

[sub_resource type="Resource" id="Resource_ab0_tgt0"]
script = ExtResource("4_tgt")
target_type = "Hand"
owner = "Ally"
targeting = "Automatic"

[sub_resource type="Resource" id="Resource_ab0_tgt1"]
script = ExtResource("4_tgt")
target_type = "Player"
owner = "Ally"
targeting = "Automatic"

[sub_resource type="Resource" id="Resource_ab0_tgt2"]
script = ExtResource("4_tgt")
target_type = "Deck"
owner = "Ally"
targeting = "Automatic"

[sub_resource type="Resource" id="Resource_ab0_eff0"]
script = ExtResource("5_eff")
step = "Search"
parameters = {"SearchFilters": "type:SPELL"}
tag = "spell_count"
target_ref = "targets[0]"

[sub_resource type="Resource" id="Resource_ab0_eff1"]
script = ExtResource("5_eff")
step = "Search"
parameters = {"SearchFilters": "type:UNIT"}
tag = "unit_count"
target_ref = "targets[0]"

[sub_resource type="Resource" id="Resource_ab0_eff2"]
script = ExtResource("5_eff")
step = "Discard"
parameters = {"DiscardFilters": "all"}
target_ref = "targets[0]"

[sub_resource type="Resource" id="Resource_ab0_eff3"]
script = ExtResource("5_eff")
step = "ModifyCounter"
parameters = {"CounterType": "Mana", "ModifyAmount": "count(spell_count.SearchResults)"}
target_ref = "targets[1]"

[sub_resource type="Resource" id="Resource_ab0_eff4"]
script = ExtResource("5_eff")
step = "Draw"
parameters = {"DrawAmount": "count(unit_count.SearchResults)"}
target_ref = "targets[2]"

[sub_resource type="Resource" id="Resource_ab0"]
script = ExtResource("2_abil")
ability_name = "All in"
description = "Dobd el a kezed. Varázslatonként 1 manát kapsz, egységenként 1 lapot húzol."
trigger = SubResource("Resource_ab0_trig")
targets = [SubResource("Resource_ab0_tgt0"), SubResource("Resource_ab0_tgt1"), SubResource("Resource_ab0_tgt2")]
effects = [SubResource("Resource_ab0_eff0"), SubResource("Resource_ab0_eff1"), SubResource("Resource_ab0_eff2"), SubResource("Resource_ab0_eff3"), SubResource("Resource_ab0_eff4")]

[resource]
script = ExtResource("1_card")
spell_type = 1
card_type = Card.CardType.SPELL
card_id = 3009
card_name = "All in"
description = "Dobd el a kezed. Az eldobott varázslatok számával egyező manát kapsz erre a körre, és az eldobott egységek számával egyező lapot húzol."
card_class = "Zsivány"
cost = 0
abilities = [SubResource("Resource_ab0")]
