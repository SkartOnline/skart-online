[gd_resource type="Resource" script_class="CharacterCard" format=3 uid="uid://df5he80vmch3e"]

[ext_resource type="Script" uid="uid://cmoe2lyoum0oe" path="res://scripts/cards/character_card.gd" id="1_card"]
[ext_resource type="Script" uid="uid://8pkq1chvkr5a" path="res://scripts/abilities/ability.gd" id="2_abil"]
[ext_resource type="Script" uid="uid://b0mosco1r307u" path="res://scripts/abilities/trigger.gd" id="3_trig"]
[ext_resource type="Script" uid="uid://b60jxsqdv6nrd" path="res://scripts/abilities/target.gd" id="4_tgt"]
[ext_resource type="Script" uid="uid://t72vfvkvypd8" path="res://scripts/abilities/effect_step.gd" id="5_eff"]

[sub_resource type="Resource" id="Resource_ab0_trig"]
script = ExtResource("3_trig")
event = "ON_PLAY"
modifier1 = "ALLY"
modifier2 = "Spell"
trigger_interactors = {"PlayedCard": "tag:Tűz"}

[sub_resource type="Resource" id="Resource_ab0_tgt0"]
script = ExtResource("4_tgt")
target_type = "Card"
owner = "Ally"
targeting = "Automatic"

[sub_resource type="Resource" id="Resource_ab0_eff0_ch0_e0"]
script = ExtResource("5_eff")
step = "ModifyStat"
parameters = {"ModifiedStat": "COST", "ModifyAmount": -1, "ModifyDuration": 4}
target_ref = "targets[0]"

[sub_resource type="Resource" id="Resource_ab0_eff0_ch1_e0"]
script = ExtResource("5_eff")
step = "ModifyStat"
parameters = {"ModifiedStat": "DAMAGE_BONUS", "ModifyAmount": 1, "ModifyDuration": 4}
target_ref = "targets[0]"

[sub_resource type="Resource" id="Resource_ab0_eff0"]
script = ExtResource("5_eff")
step = ""
flow = {"type": "choose_one"}
choices = [{"label": "Tűz Kedvezmény: 1-gyel kevesebbe kerül", "effects": [SubResource("Resource_ab0_eff0_ch0_e0")]}, {"label": "Tűz Erősítés: 1-gyel több sebzést okoz", "effects": [SubResource("Resource_ab0_eff0_ch1_e0")]}]

[sub_resource type="Resource" id="Resource_ab0"]
script = ExtResource("2_abil")
ability_name = "Néma Tüzek"
description = "Amikor kijátszol egy Tűz varázslatot, válassz egyet."
trigger = SubResource("Resource_ab0_trig")
targets = [SubResource("Resource_ab0_tgt0")]
effects = [SubResource("Resource_ab0_eff0")]

[resource]
script = ExtResource("1_card")
title = "a Néma Tüzek Őre"
card_id = 1001
card_name = "Explodus"
description = "Amikor kijátszol egy Tűz varázslatot, válassz: 1-gyel kevesebbe kerül, VAGY 1-gyel több sebzést okoz."
card_class = "Mágus"
abilities = [SubResource("Resource_ab0")]
