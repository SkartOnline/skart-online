[resource]
script = ExtResource("1_card")
title = "a Holló"
game_rules = {"diagonal_placement": true}
card_id = 1015
card_name = "Gúner"
description = "Átlósan is kijátszhatsz egységeket a meglévő egységeid mellé. Ha egy egységed oldalról támad, +1 támadás. Ha hátulról, +2 és Ütéselőnyt is kap."
card_class = "Zsivány"
abilities = [SubResource("Resource_ab0")]
