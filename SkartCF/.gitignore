node_modules/
dist/
*.local
.vite/

# Training checkpoints are scratch, except the one the app and the simulator
# actually load, which has to travel with the code that reads it.
src/bot/weights/*
!src/bot/weights/latest.json

# Scratch from one-off training and sweep scripts.
final.*
sweep.*
sim.txt

# Balance runs: the JSON and the page built from it are both generated, and a
# thousand-game report is megabytes. `npm run sim -- --report` remakes them.
reports/
sim*.txt
