# The matchmaking relay, baked into the bundle at build time.
#
# Unset, the lobby still works between two tabs of one browser and says so on
# screen. Set it to reach another machine. `wss://` for a site served over
# HTTPS — a browser will not open a plaintext socket from a secure page.
#
# Copy to `.env` to use locally. For the published site, set the repository
# variable RELAY_URL instead; the Pages workflow passes it to the build.
VITE_RELAY_URL=ws://localhost:8787
