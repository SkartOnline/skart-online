{
  "name": "skartcf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/sim/run.ts",
    "combos": "tsx src/bot/comboscan.ts",
    "theta": "tsx src/bot/thetascan.ts",
    "belief": "tsx src/bot/beliefscan.ts",
    "planner": "tsx src/bot/planscan.ts",
    "replay": "tsx src/bot/replay.ts",
    "decks": "tsx src/bot/deckscan.ts",
    "mirror": "tsx src/bot/mirror.ts",
    "relay": "tsx server/relay.ts",
    "smoke": "tsx server/smoke.ts",
    "relay:dev": "wrangler dev --config worker/wrangler.toml",
    "relay:deploy": "wrangler deploy --config worker/wrangler.toml",
    "relay:check": "tsc --noEmit -p worker/tsconfig.json",
    "stats": "tsx src/sim/stats.ts"
  },
  "dependencies": {
    "@fontsource/spectral": "^5.3.0",
    "@types/ws": "^8.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.127.1"
  }
}
